{
  "name": "woonuxt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "prebuild": "npm run graphql:codegen",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "dev": "nuxt dev",
    "predev": "npm run graphql:codegen",
    "dev:host": "nuxt dev --host 0.0.0.0",
    "predev:host": "npm run graphql:codegen",
    "dev:ssl": "NODE_TLS_REJECT_UNAUTHORIZED=0 nuxt dev --https --ssl-cert localhost.pem --ssl-key localhost-key.pem",
    "predev:ssl": "npm run graphql:codegen",
    "generate": "nuxt generate",
    "pregenerate": "npm run graphql:codegen",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "serve": "npm run generate && npx serve .output/public -l 8080",
    "typecheck": "nuxi typecheck",
    "pretypecheck": "npm run graphql:codegen",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@stripe/stripe-js": "^10.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.1.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^8.0.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-graphql-request": "^8.0.2",
    "@graphql-codegen/typescript-operations": "7.0.2",
    "@iconify-json/ion": "^1.2.8",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/icon": "^2.6.3",
    "@nuxt/image": "2.2.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vite-pwa/nuxt": "^2.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "nuxt": "^4.7.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "vue-i18n": "11.4.23",
    "vue-tsc": "^3.3.14"
  }
}
